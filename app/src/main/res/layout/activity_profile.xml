<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_page"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mon Profil"
            style="@style/TextAppearance.App.Subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/avatarContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/avatar"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile"
                            android:background="@color/mint_light"
                            android:padding="4dp"
                            app:strokeColor="@color/mint_primary"
                            app:strokeWidth="2dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            app:tint="@color/mint_dark" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_pill_light"
                            android:backgroundTint="@color/mint_primary"
                            android:padding="6dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/nameContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/avatarContainer"
                        app:layout_constraintTop_toTopOf="@id/avatarContainer"
                        app:layout_constraintBottom_toBottomOf="@id/avatarContainer">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/profileName"
                                style="@style/TextAppearance.App.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Entrez votre nom"
                                android:textSize="20sp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/mint_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/profileEmail"
                            style="@style/TextAppearance.App.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Membre" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adhésion"
                        android:textSize="12sp"
                        android:textColor="@color/mint_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adhérent Actif"
                        style="@style/TextAppearance.App.Subtitle"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvCredits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 crédit(s) restant(s)"
                        android:textSize="12sp"
                        android:textColor="@color/mint_primary"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MON ACTIVITÉ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/btnMyReservations"
                        layout="@layout/item_profile_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background_page"/>

                    <include
                        android:id="@+id/btnHistory"
                        layout="@layout/item_profile_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background_page"/>

                    <include
                        android:id="@+id/btnFavorites"
                        layout="@layout/item_profile_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIDE ET INFORMATIONS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/btnCredits"
                        layout="@layout/item_profile_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background_page"/>

                    <include
                        android:id="@+id/btnFaq"
                        layout="@layout/item_profile_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background_page"/>

                    <include
                        android:id="@+id/btnPrivacy"
                        layout="@layout/item_profile_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background_page"/>

                    <include
                        android:id="@+id/btnSupport"
                        layout="@layout/item_profile_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/logoutButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Déconnexion"
                android:textColor="@color/status_unavailable"
                android:backgroundTint="#FEE2E2"/> </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>